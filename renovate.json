{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>DIRACGrid/.github//renovate-config"
  ],
  "enabledManagers": [
    "pip_requirements",
    "pep621",
    "github-actions",
    "custom.regex"
  ],
  "ignorePaths": [
    ".pixi/**",
    "**/__pycache__/**",
    "**/venv/**",
    "**/env/**"
  ],
  "packageRules": [
    {
      "description": "Python rangeStrategy (moved here from the deprecated top-level python option)",
      "matchCategories": [
        "python"
      ],
      "rangeStrategy": "auto"
    },
    {
      "description": "Group all Python dependency updates together",
      "matchManagers": [
        "pip_requirements",
        "pep621"
      ],
      "groupName": "Python dependencies",
      "labels": [
        "dependencies",
        "python"
      ]
    },
    {
      "description": "Python version requirements - be conservative",
      "matchDatasources": [
        "pypi"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "30 days"
    },
    {
      "description": "Group build dependencies",
      "matchPackageNames": [
        "hatchling",
        "hatch-vcs"
      ],
      "groupName": "Build dependencies",
      "labels": [
        "dependencies",
        "build"
      ]
    },
    {
      "description": "Group test dependencies",
      "matchPackageNames": [
        "/^pytest/",
        "moto",
        "aiobotocore",
        "botocore"
      ],
      "groupName": "Testing dependencies",
      "labels": [
        "dependencies",
        "testing"
      ]
    },
    {
      "description": "rustfs - only stable releases (ignores alpha, beta, glibc)",
      "matchDepNames": [
        "rustfs/rustfs"
      ],
      "allowedVersions": "/^\\d+(\\.\\d+)+$/"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)conftest\\.py$/"
      ],
      "matchStrings": [
        "rustfs/rustfs:(?<currentValue>[\\w.-]+)"
      ],
      "depNameTemplate": "rustfs/rustfs",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    }
  ]
}
